#!/usr/bin/env bash

##############################################################################
##
##  Gradle start up script for UN*X
##
##############################################################################

# Attempt to set APP_HOME
PRG="$0"
while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=`dirname "$PRG"`"/$link"
    fi
done
APP_HOME=`dirname "$PRG"`
APP_HOME=`cd "$APP_HOME" && pwd`

# Define JAR locations
GRADLE_WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
GRADLE_WRAPPER_SHARED_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper-shared.jar"
GRADLE_CLI_JAR="$APP_HOME/gradle/wrapper/gradle-cli.jar"
GRADLE_FILES_JAR="$APP_HOME/gradle/wrapper/gradle-files.jar" # Added Files JAR

# Check if all JARs exist (make shared jar optional for check as it might disappear in future Gradle versions)
if [ ! -f "$GRADLE_WRAPPER_JAR" ]; then echo "ERROR: Missing $GRADLE_WRAPPER_JAR"; fi
if [ ! -f "$GRADLE_CLI_JAR" ]; then echo "ERROR: Missing $GRADLE_CLI_JAR"; fi
if [ ! -f "$GRADLE_FILES_JAR" ]; then echo "ERROR: Missing $GRADLE_FILES_JAR"; fi

# Define the classpath including all JARs
# If gradle-wrapper-shared.jar doesn't exist, don't include it in classpath (to handle future gradle versions)
CLASSPATH="$GRADLE_WRAPPER_JAR:$GRADLE_CLI_JAR:$GRADLE_FILES_JAR"
if [ -f "$GRADLE_WRAPPER_SHARED_JAR" ]; then
    CLASSPATH="$CLASSPATH:$GRADLE_WRAPPER_SHARED_JAR"
fi

DEFAULT_JVM_OPTS=""

# Determine the Java command
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
    if [ ! -x "$JAVACMD" ] ; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || (echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." && exit 1)
fi

# Split up the JVM options
DEFAULT_JVM_OPTS=($DEFAULT_JVM_OPTS)
GRADLE_OPTS=($GRADLE_OPTS)
JAVA_OPTS=($JAVA_OPTS)

# Execute Gradle
exec "$JAVACMD" \
    "${DEFAULT_JVM_OPTS[@]}" \
    "${JAVA_OPTS[@]}" \
    "${GRADLE_OPTS[@]}" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
